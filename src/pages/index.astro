---
import Layout from '../layouts/Layout.astro';
import Portrait from '../components/Portrait.astro';
import portrait from '../assets/portrait.webp?url';
import CoinToss from '../components/CoinToss.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projectsData from '../data/projects.json';
import { formatPostDate, getPostSlug, getPublishedPosts, getReadingTime } from '../utils/blog';
const featuredProjects = projectsData.projects.filter((project) => project.featured);
const latestPosts = (await getPublishedPosts()).slice(0, 3);
---

<Layout title="Corbin Riches">
	<section class="home-board">
		<div class="hero">
			<h1>Corbin Riches</h1>
			<p class="hero-role">MASc Student @ Queen's University</p>
			<p class="hero-subtitle">Photonics · Quantum Sensing · Cryogenics</p>
			<p class="hero-supervision">MASc research with Dr. James Fraser and Dr. Joe Bramante</p>
		</div>
		<Portrait src={portrait} />
		<div class="hero-introduction">
			<p class="hero-copy">I am pursuing my MASc at Queen's University, working on dark-photon detection through photonics, quantum sensing, and cryogenic experimental systems. I am a Canadian engineering physicist from a small town in Northwestern Ontario, drawn to the challenge of making difficult-to-observe physics measurable. This site is home to my projects, notes, experiments, and writing about whatever has me curious.</p>
			<div class="hero-actions" aria-label="Primary links">
				<a class="button primary" href="/projects/">projects</a>
				<a class="button" href="/blog/">writing</a>
				<a class="button" href="/contact/">contact</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="section-heading">
			<p class="eyebrow">portfolio/projects</p>
			<h2>Selected projects</h2>
		</div>
		<div class="card-grid">
			{featuredProjects.map((project) => (
				<ProjectCard
					title={project.title}
					description={project.summary}
					tags={project.tags}
					type={project.type}
					href={`/projects/#project-${project.slug}`}
				/>
			))}
		</div>
	</section>

	{latestPosts.length > 0 && (
		<section class="section latest-writing" aria-label="Latest writing">
			<div class="section-heading">
				<p class="eyebrow">notebook/recent</p>
				<h2>Latest writing</h2>
			</div>
			<div class="latest-writing-list">
				{latestPosts.map((post) => (
					<article class="home-module latest-writing-card">
						<p class="eyebrow">{formatPostDate(post.data.date)} / {getReadingTime(post.body)}</p>
						<h3><a href={`/blog/${getPostSlug(post)}/`}>{post.data.title}</a></h3>
						<p>{post.data.description}</p>
					</article>
				))}
			</div>
			<p class="module-link"><a href="/blog/">open notebook</a></p>
		</section>
	)}

	<section class="section link-panel" aria-label="Site map">
		<a href="/about/">About</a>
		<a href="/projects/">Projects</a>
		<a href="/blog/">Writing</a>
		<a href="/bookshelf/">Reading</a>
		<a href="/contact/">Contact</a>
	</section>

	<details class="section experiment-drawer">
		<summary>coin_toss.exe — a small experiment</summary>
		<CoinToss />
	</details>
</Layout>
