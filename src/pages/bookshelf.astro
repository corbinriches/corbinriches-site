---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { books } from '../data/reading';
import { paperArchive, publishedPaperNotes } from '../utils/reading';
import { formatPostDate } from '../utils/blog';

const shelves = [
	{ title: 'Currently Reading', status: 'current' },
	{ title: 'Recently Finished', status: 'finished' },
].map((group) => ({
	...group,
	entries: books.filter((book) => book.status === group.status),
})).filter((group) => group.entries.length > 0);
---

<Layout title="Reading" description="Personal reading and paper notes from Corbin Riches.">
	<section class="page-header">
		<p class="eyebrow">reading</p>
		<h1>Books, papers, and notes.</h1>
		<nav class="blog-tag-nav" aria-label="Reading sections">
			<a href="#bookshelf">Personal reading</a> · <a href="#paper-notes">{paperArchive.title}</a>
		</nav>
	</section>

	<section class="section bookshelf-groups" id="bookshelf" aria-labelledby="bookshelf-heading">
		<h2 id="bookshelf-heading">Personal reading</h2>
		{shelves.map((group) => (
			<div class="bookshelf-group">
				<div class="bookshelf-group-header">
					<h3>{group.title}</h3>
					<p class="bookshelf-count">{group.entries.length} {group.entries.length === 1 ? 'book' : 'books'}</p>
				</div>
				<div class="bookshelf-card-grid">
					{group.entries.map((book) => <BookCard book={book} />)}
				</div>
			</div>
		))}
		{shelves.length === 0 && <p>No books listed.</p>}
	</section>

	<section class="section" id="paper-notes" aria-labelledby="paper-notes-heading">
		<div class="section-heading">
			<p class="eyebrow">papers/archive</p>
			<h2 id="paper-notes-heading">{paperArchive.title}</h2>
		</div>
		{publishedPaperNotes.length > 0 ? (
			<div class="post-list">
				{publishedPaperNotes.map((note) => (
					<article class="post-card paper-note" id={`paper-${note.slug}`}>
						<p class="eyebrow">
							<a href={`#paper-${note.slug}`} aria-label={`Link to note on ${note.title}`}>
								<time datetime={note.date.toISOString()}>{formatPostDate(note.date)}</time>
							</a>
						</p>
						<h3><a href={note.link}>{note.title}</a></h3>
						<p class="bookshelf-creator">{note.authors.join(', ')}</p>
						<p class="bookshelf-notes">{note.citation}</p>
						<dl class="paper-note-body">
							<div><dt>About the paper</dt><dd>{note.summary}</dd></div>
							<div><dt>Why it caught my attention</dt><dd>{note.interest}</dd></div>
							<div><dt>The idea in my own words</dt><dd>{note.idea}</dd></div>
						</dl>
					</article>
				))}
			</div>
		) : <p>No published paper notes yet.</p>}
	</section>
</Layout>
