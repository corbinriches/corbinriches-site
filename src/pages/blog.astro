---
import Layout from '../layouts/Layout.astro';
import {
	formatPostDate,
	getPostSlug,
	getPublishedPosts,
	getReadingTime,
	getTagSummaries,
	slugifyTag,
} from '../utils/blog';

const posts = await getPublishedPosts();
const tags = getTagSummaries(posts);
---

<Layout title="Writing" description="Technical notes and short essays from Corbin Riches.">
	<section class="page-header">
		<p class="eyebrow">writing</p>
		<h1>Writing.</h1>
		{tags.length > 0 && <p class="blog-tag-nav"><a href="/blog/tags/">browse tags</a></p>}
	</section>

	<section class="section">
		{
			posts.length > 0 ? (
				<div class="post-list">
					{posts.map((post) => (
						<article class="post-card">
							<p class="eyebrow">{getReadingTime(post.body)}</p>
							<h2><a href={`/blog/${getPostSlug(post)}/`}>{post.data.title}</a></h2>
							<div class="post-meta">
								<time datetime={post.data.date.toISOString()}>
									{formatPostDate(post.data.date)}
								</time>
								{post.data.tags.length > 0 && (
									<ul class="tag-list" aria-label={`${post.data.title} tags`}>
										{post.data.tags.map((tag) => (
											<li><a href={`/blog/tags/${slugifyTag(tag)}/`}>{tag}</a></li>
										))}
									</ul>
								)}
							</div>
							<p>{post.data.description}</p>
						</article>
					))}
				</div>
			) : (
				<div class="empty-state">
					<p>No published writing yet.</p>
				</div>
			)
		}
	</section>
</Layout>
