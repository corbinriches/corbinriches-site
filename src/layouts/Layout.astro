---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
	title = 'Corbin Riches',
	description = 'Corbin Riches, MASc student at Queen\'s University working in photonics, quantum mechanics, and cryogenics.',
} = Astro.props;

const pageTitle = title === 'Corbin Riches' ? title : `${title} | Corbin Riches`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			(() => {
				try {
					const savedTheme = localStorage.getItem('corbin-theme');
					document.documentElement.dataset.theme = savedTheme === 'dark' ? 'dark' : 'light';
				} catch {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<div class="site-shell">
			<Header />
			<main class="site-main">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>
